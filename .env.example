# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` — it is gitignored.

# Server-side key for the GEMINI DEVELOPER API (generativelanguage.googleapis.com).
# NOT Vertex AI — different product, different quota, different billing line.
# The old name VERTEX_API_KEY is still read as a fallback.
GEMINI_API_KEY=

# Firebase service-account JSON, single line. REQUIRED: without it /api/chat
# cannot verify ID tokens or meter usage, and refuses every request (503).
# An unauthenticated /api/chat is a public endpoint that spends your money.
FIREBASE_SERVICE_ACCOUNT=

# Per-user daily spend caps. Anonymous accounts are free to recreate, so their
# allowance is deliberately smaller.
QUOTA_ANON_TURNS_PER_DAY=10
QUOTA_ANON_SEARCHES_PER_DAY=2
QUOTA_USER_TURNS_PER_DAY=50
QUOTA_USER_SEARCHES_PER_DAY=10

# Firebase client SDK config (NEXT_PUBLIC_* is exposed to the browser by design).
# Security relies on Firestore rules + App Check, not on hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# YouTube Data API v3 key. Optional but recommended: without it the
# youtube_summarize tool still summarises captions, but video title, channel,
# duration and thumbnail are always null, and "summarize the video about X"
# (search by title, as opposed to a pasted URL) cannot work at all.
YOUTUBE_API_KEY=

# Optional model overrides — see src/lib/models.ts for defaults.
# GEMINI_CHAT_MODEL=
# GEMINI_FAST_MODEL=
# GEMINI_IMAGE_MODEL=
# GEMINI_CHAT_FALLBACKS=
